# Conexão direta com o Postgres do Supabase (service role / usuário postgres), usada só pelo ETL.
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
# Opcional
# DADOS_DIR=./data
# TAMANHO_LOTE_GERADOR=200000

# --- API (FastAPI) ---
# Usuário só leitura criado pela migration 0600 (defina a senha uma vez com
#   alter role api_leitura with login password '...';
# no SQL Editor). Pelo pooler (modo transação, porta 6543) o usuário é "api_leitura.<project-ref>".
API_DATABASE_URL=postgresql://api_leitura.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
# Origens liberadas no CORS (Expo web em desenvolvimento), separadas por vírgula.
CORS_ORIGINS=http://localhost:8081

  "info": {
    "description": "Oportunidades de valorização de resíduos industriais (IBAMA RAPP + diagnóstico municipal).",
    "title": "Waste Colab API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/municipios": {
      "get": {
        "operationId": "buscar_municipios_v1_municipios_get",
        "parameters": [
          {
            "in": "query",
            "name": "uf",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z]{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Uf"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 80,
                  "minLength": 2,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "limite",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 50,
              "minimum": 1,
              "title": "Limite",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Municipio"
                  },
                  "title": "Response Buscar Municipios V1 Municipios Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            },
            "description": "Parâmetros inválidos"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            },
            "description": "Erro interno"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            },
            "description": "Banco indisponível"
          }
        },
        "summary": "Buscar Municipios",
        "tags": [
          "filtros"
        ]
      }
    },
    "/v1/municipios/{id_ibge}/contexto": {
      "get": {
        "operationId": "contexto_municipio_v1_municipios__id_ibge__contexto_get",
        "parameters": [

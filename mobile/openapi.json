                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            },
            "description": "Município inexistente"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            },
            "description": "Parâmetros inválidos"

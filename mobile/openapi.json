            },
            "description": "Banco indisponível"
          }
        },
        "summary": "Contexto Municipio",
        "tags": [
          "municipios"
        ]
      }
    },
    "/v1/oportunidades": {
      "get": {
        "operationId": "listar_oportunidades_v1_oportunidades_get",
        "parameters": [
          {
            "description": "Raio das rotas a partir do gerador",
            "in": "query",
            "name": "raio_km",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/RaioKm",
              "default": 100,
              "description": "Raio das rotas a partir do gerador"
            }
          },
          {
            "description": "Sigla da UF, ex.: SP",
            "in": "query",
            "name": "uf",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z]{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Sigla da UF, ex.: SP",
              "title": "Uf"
            }
          },
          {
            "in": "query",
            "name": "municipio_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 9999999,
                  "minimum": 1000000,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Municipio Id"
            }
          },
          {
            "in": "query",
            "name": "lat",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 90,
                  "minimum": -90,
                  "type": "number"
                },
                {
                  "type": "null"
                }
